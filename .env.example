# ── Database ──
#
# ── Which connection string, and why it matters ──
#
# DIRECT   db.<ref>.supabase.co:5432
#          Has an AAAA record and NO A record — IPv6 only. Fine from a
#          laptop with IPv6. On Vercel it does not resolve at all:
#          getaddrinfo ENOTFOUND, on every request that touches the
#          database. Use it for migrations from a machine that has IPv6.
#
# POOLER   aws-0-<region>.pooler.supabase.com:6543  (Supavisor,
#          transaction mode)
#          Resolves to real IPv4 addresses, which is what a serverless
#          function can reach. This is what a deployment must use.
#
# Transaction-mode pooling is safe here because withSession() sets its
# claims with set_config(..., true) and SET LOCAL inside an explicit
# transaction — nothing depends on session state surviving between
# statements. Verified: all 15 db:verify checks pass through the
# pooler, including the RLS scoping.
#
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/inventory_core

# ── The Supabase test target ──
#
# A SECOND, DISPOSABLE Supabase project, used only by
#
#   npm run test:supabase -- --target=<host>
#
# It exists because the local container can only imitate Supabase. It
# now imitates it closely — Postgres 17, the `extensions` schema, the
# same roles — and that is enough to catch the class of bug that broke
# a deploy once. It is not enough to prove Supavisor's transaction
# pooling, Supabase's own auth.jwt(), or pg_cron.
#
# It is SEPARATE from DATABASE_URL on purpose. The suite truncates
# every inventory table, repeatedly, and the whole point of a second
# variable is that emptying the wrong database should require setting
# the wrong variable, not merely forgetting which one is which.
#
# Use the DIRECT connection here (port 5432), not the pooler: the
# migrations this runs create functions and set roles, and there is no
# serverless function involved to need IPv4.
#
# TEST_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# ── Image storage ─────────────────────────────────────────────────
#
# local     writes to ./.storage. Development only, and the driver
#           REFUSES to start on Vercel — a serverless filesystem
#           accepts a write and loses it, which looks like a working
#           feature for exactly as long as one request.
#
# supabase  Supabase Storage. Production.
#
STORAGE_DRIVER=local

# Only for STORAGE_DRIVER=supabase.
#
# The SERVICE ROLE key, not the anon key: writing to storage has to
# bypass row-level security. It is a master key for the project —
# server-side only, never in a NEXT_PUBLIC_* variable, never committed.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=product-images

# Public bucket by default: a customer app renders <img src>, and a
# browser will not attach a bearer token to that. Keys are SHA-256
# hashes, so an object is unguessable even when public. Set to false to
# serve every image through /images instead — correct, but the
# bandwidth is then paid for twice.
# SUPABASE_STORAGE_PUBLIC=true

# Absolute base for image URLs in API responses. Set this when the app
# is behind a proxy or a custom domain; otherwise it is derived from
# the request's forwarded headers.
# PUBLIC_BASE_URL=https://inventory.example.com

# ── The administrator ──
#
# This system has its own authentication (platform.sign_in, bcrypt in
# platform.credential). Supabase Auth and auth.users are not involved.
#
# With these set, the single administrator signs in from here rather
# than from the credential table. The identity row in platform.app_user
# is still created automatically on first login — about forty columns
# reference it (raised_by, approved_by, actor_id on every ledger
# entry), so "who did this" must name somebody who exists.
#
# Anyone who can read this file can sign in as admin: there is no
# second factor, no bcrypt work factor, and no lockout counter to
# increment. Rotating the password means a redeploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=System Admin

# ── The queue drain (webhook delivery) ──
#
# scripts/webhook-worker.mjs is the right shape — a long-lived process
# that claims, sends, records, and sleeps only when the queue is empty.
# There is nowhere to run one on Vercel, so the queue is POKED instead:
# a scheduler calls POST /api/internal/drain and it does one pass.
#
# Vercel Cron authenticates with CRON_SECRET, which Vercel injects into
# the request itself — set it here and Vercel sends it. The cron entry
# is in vercel.json, once a minute.
#
#   IMPORTANT: per-minute crons need a Vercel Pro plan. On Hobby, cron
#   runs once a day, which is useless for delivery. Use GitHub Actions
#   or any external cron against the same route instead — that is why
#   it is an HTTP endpoint and not a Vercel-only handler.
CRON_SECRET=

# Any OTHER scheduler calling the same route — GitHub Actions, an
# external cron, a laptop. Accepted alongside CRON_SECRET so you are
# not forced onto one scheduler.
#
#   curl -X POST -H "Authorization: Bearer $WORKER_SECRET" #     https://<inventory-host>/api/internal/drain
WORKER_SECRET=
