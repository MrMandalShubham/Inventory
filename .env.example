# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/inventory_core

# ── Image storage ─────────────────────────────────────────────────
#
# local     writes to ./.storage. Development only, and the driver
#           REFUSES to start on Vercel — a serverless filesystem
#           accepts a write and loses it, which looks like a working
#           feature for exactly as long as one request.
#
# supabase  Supabase Storage. Production.
#
STORAGE_DRIVER=local

# Only for STORAGE_DRIVER=supabase.
#
# The SERVICE ROLE key, not the anon key: writing to storage has to
# bypass row-level security. It is a master key for the project —
# server-side only, never in a NEXT_PUBLIC_* variable, never committed.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=product-images

# Public bucket by default: a customer app renders <img src>, and a
# browser will not attach a bearer token to that. Keys are SHA-256
# hashes, so an object is unguessable even when public. Set to false to
# serve every image through /images instead — correct, but the
# bandwidth is then paid for twice.
# SUPABASE_STORAGE_PUBLIC=true

# Absolute base for image URLs in API responses. Set this when the app
# is behind a proxy or a custom domain; otherwise it is derived from
# the request's forwarded headers.
# PUBLIC_BASE_URL=https://inventory.example.com

# ── The administrator ──
#
# This system has its own authentication (platform.sign_in, bcrypt in
# platform.credential). Supabase Auth and auth.users are not involved.
#
# With these set, the single administrator signs in from here rather
# than from the credential table. The identity row in platform.app_user
# is still created automatically on first login — about forty columns
# reference it (raised_by, approved_by, actor_id on every ledger
# entry), so "who did this" must name somebody who exists.
#
# Anyone who can read this file can sign in as admin: there is no
# second factor, no bcrypt work factor, and no lockout counter to
# increment. Rotating the password means a redeploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=System Admin
